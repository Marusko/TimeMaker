<Window x:Class="TimeMaker.Windows.ExportSeparatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Výber CSV rozdeľovača" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Topmost="True" Icon="../Icons/favicon.ico"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Width="280" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel Margin="20">
                <TextBlock Text="Nastavenia exportu" Style="{StaticResource TitleTextStyle}" FontSize="17"/>

                <TextBlock Text="Rozdeľovač CSV" Style="{StaticResource FieldLabelStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SemiColonRadio" Content=";" Checked="DelimiterChecked"
                                 IsChecked="True" GroupName="delimiter" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ColonRadio" Content="," Checked="DelimiterChecked"
                                 GroupName="delimiter" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="Ďalej" Click="Export" HorizontalAlignment="Right"
                        MinWidth="100" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
