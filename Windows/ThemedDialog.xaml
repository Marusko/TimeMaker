<Window x:Class="TimeMaker.Windows.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}">
    <!-- Two layers: an empty border carries the (rasterised) drop shadow, the
         content border on top renders text crisply with no effect applied. -->
    <Grid Margin="18">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Width="380" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel Margin="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBadge" Grid.Column="0" Width="36" Height="36"
                            CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextStyle}" FontSize="17" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText" Margin="0,8,0,0" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="86" Margin="0,0,8,0" Click="SecondaryButton_Click" />
                    <Button x:Name="PrimaryButton" MinWidth="86" Click="PrimaryButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
