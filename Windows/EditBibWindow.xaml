<Window x:Class="TimeMaker.Windows.EditBibWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Zmena čísla" Height="100" Width="200"  WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Topmost="True" Icon="../Icons/favicon.ico">
    <GroupBox Header="Zmena čísla">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="BibText" Grid.Row="0" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
            <Button Grid.Row="1" Content="Uložiť" Click="Save" HorizontalAlignment="Right" Margin="0,10,10,0" Padding="10 5" VerticalAlignment="Top" Width="93"/>
        </Grid>
    </GroupBox>
</Window>
