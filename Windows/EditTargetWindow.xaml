<Window x:Class="TimeMaker.Windows.EditTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Zmena cieľových bodov" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True" Icon="../Icons/favicon.ico"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Background="{StaticResource WindowBackgroundBrush}">
    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="20">
        <StackPanel>
            <TextBlock Text="Zmena cieľových bodov" Style="{StaticResource TitleTextStyle}" FontSize="17"/>

            <TextBlock Text="Cieľové meracie body" Style="{StaticResource FieldLabelStyle}"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" x:Name="FirstTargetLabel" Content="C0 / C0M bod:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="StartPoint" Margin="10,0,0,6"/>
                <Label Grid.Row="1" Grid.Column="0" x:Name="SecondTargetLabel" Content="C1 / C1M bod:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FinishPoint" Margin="10,0,0,6"/>
                <Label Grid.Row="2" Grid.Column="0" x:Name="ThirdTargetLabel" Content="RT / RTM bod:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RunTimePoint" Margin="10,0,0,0" IsEnabled="False"/>
            </Grid>

            <Button Content="Uložiť" Click="Save" HorizontalAlignment="Right" MinWidth="100" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>
