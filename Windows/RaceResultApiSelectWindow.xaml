<Window x:Class="TimeMaker.Windows.RaceResultApiSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeMaker.ViewModels"
        mc:Ignorable="d"
        Title="Výber API" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True" Icon="../Icons/favicon.ico"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Background="{StaticResource WindowBackgroundBrush}">
    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="20">
        <StackPanel>
            <TextBlock Text="Vytvorenie API" Style="{StaticResource TitleTextStyle}" FontSize="17"/>
            <TextBlock x:Name="EventNameText" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="Vyberte, ktoré API sa majú na podujatí vytvoriť. Existujúce API zostanú zachované, opraví sa iba to, čo je nastavené inak."
                       Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <ItemsControl x:Name="ApiList" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ApiSelectionItemViewModel}">
                        <!-- The checkbox sits in its own column so the hint below wraps inside
                             the row instead of being clipped by the checkbox's content. -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding IsToggleable}" VerticalAlignment="Top"
                                      Margin="0,2,8,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LabelText}" Style="{StaticResource HintTextStyle}"
                                           FontFamily="Consolas"/>
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource HintTextStyle}"
                                           Visibility="{Binding HintVisibility}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="6"
                                    Padding="8,2" VerticalAlignment="Top" Margin="8,0,0,0"
                                    Visibility="{Binding MandatoryVisibility}">
                                <TextBlock Text="Povinné" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BadgeForegroundBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,20,0,0">
                <Button Content="Zrušiť" Click="Cancel" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" IsCancel="True"/>
                <Button Content="Vytvoriť" Click="Create" HorizontalAlignment="Right"
                        MinWidth="100" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
