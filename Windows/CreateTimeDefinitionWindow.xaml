<Window x:Class="TimeMaker.Windows.CreateTimeDefinitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TimeMaker.ViewModels"
        mc:Ignorable="d"
        Title="Definícia časov" Width="860" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Topmost="True" Icon="../Icons/favicon.ico"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- Compact variants: a part card packs five fields, so the default field
             spacing and input padding make it needlessly tall. -->
        <Style x:Key="PartFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,7,0,2"/>
        </Style>
        <Style x:Key="PartTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,0,2,10">
            <TextBlock Text="Definícia časov" Style="{StaticResource TitleTextStyle}" FontSize="17"/>
            <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0"
                       Text="Každá časť rozdelí svoj rozsah čísel do vĺn. Ďalšiu časť pridajte tam, kde je iný interval alebo väčšia pauza medzi kategóriami."/>
        </StackPanel>

        <!-- Parts -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Časti definície" Margin="0,0,10,0" Padding="10,8,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <ItemsControl x:Name="PartsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:TimeDefinitionPartViewModel}">
                                <Border Style="{StaticResource CardStyle}" Padding="10,6,10,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Header}"
                                                       FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12">
                                                <Hyperlink Click="RemovePart">
                                                    <Run Text="Odstrániť"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Prvý čas"
                                                       Style="{StaticResource PartFieldLabelStyle}"/>
                                            <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource PartTextBoxStyle}"
                                                     Text="{Binding FirstTime, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Prvé číslo"
                                                       Style="{StaticResource PartFieldLabelStyle}"/>
                                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource PartTextBoxStyle}"
                                                     Text="{Binding FirstBib, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Posledné číslo"
                                                       Style="{StaticResource PartFieldLabelStyle}"/>
                                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource PartTextBoxStyle}"
                                                     Text="{Binding LastBib, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Počet vo vlne"
                                                       Style="{StaticResource PartFieldLabelStyle}"/>
                                            <TextBox Grid.Row="3" Grid.Column="0" Style="{StaticResource PartTextBoxStyle}"
                                                     Text="{Binding WaveSize, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Čas medzi vlnami"
                                                       Style="{StaticResource PartFieldLabelStyle}"/>
                                            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource PartTextBoxStyle}"
                                                     Text="{Binding WaveInterval, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}"
                                                   Style="{StaticResource HintTextStyle}" Margin="0,7,0,0"
                                                   Foreground="{StaticResource ErrorBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="1" Content="Pridať časť" Click="AddPart" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Preview -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Náhľad" Padding="6,8,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PreviewSummary" Style="{StaticResource SubtitleTextStyle}"
                           Margin="6,0,6,8"/>
                <ListView Grid.Row="1" x:Name="PreviewList">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Časť" DisplayMemberBinding="{Binding Part}" Width="45"/>
                            <GridViewColumn Header="Číslo" DisplayMemberBinding="{Binding Bib}" Width="70"/>
                            <GridViewColumn Header="Čas" DisplayMemberBinding="{Binding Time}" Width="100"/>
                            <GridViewColumn Header="" DisplayMemberBinding="{Binding Note}" Width="75"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,2,0">
            <Button Content="Zrušiť" Click="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="100" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="Uložiť" Click="Save" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
