<Window x:Class="TimeMaker.Windows.SerialFlagsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nastavenie príznakov" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Topmost="True" Icon="../Icons/favicon.ico"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Width="260" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel Margin="20">
                <TextBlock Text="Nastavenie príznakov" Style="{StaticResource TitleTextStyle}" FontSize="17"/>

                <TextBlock Text="Spracovávané príznaky" Style="{StaticResource FieldLabelStyle}"/>
                <StackPanel>
                    <CheckBox x:Name="BoxCorrect" Margin="0,4"/>
                    <CheckBox x:Name="BoxQuestion" Content="?" Margin="0,4"/>
                    <CheckBox x:Name="BoxSmallC" Content="c" Margin="0,4"/>
                    <CheckBox x:Name="BoxBigC" Content="C" Margin="0,4"/>
                    <CheckBox x:Name="BoxInfo" Content="i" Margin="0,4"/>
                    <CheckBox x:Name="BoxMemo" Content="m" Margin="0,4"/>
                </StackPanel>

                <Button Content="Uložiť" Click="Save" HorizontalAlignment="Right"
                        MinWidth="100" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
